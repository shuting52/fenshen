<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sakuga VFX 主题：白纸 + 墨字 + 紫线 + 粉红点缀，状态栏白底配深色图标 -->
    <style name="Theme.BlackBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="actionMenuTextColor">@color/primary_text</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- 右上角菜单：白纸卡片 -->
        <item name="android:popupMenuStyle">@style/SakugaPopupMenu</item>
        <item name="popupMenuStyle">@style/SakugaPopupMenu</item>
        <!-- 全局弹窗统一白纸卡片 -->
        <item name="md_background_color">@color/paper</item>
        <item name="md_color_title">@color/primary_text</item>
        <item name="md_color_content">@color/primary_text</item>
        <item name="md_color_button_text">@color/accent</item>
        <item name="md_color_hint">@color/secondary_text</item>
        <item name="md_color_widget">@color/accent</item>
        <item name="md_color_widget_unchecked">@color/secondary_text</item>
        <item name="md_divider_color">@color/track</item>
        <item name="md_corner_radius">15dp</item>
    </style>

    <style name="SakugaPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_sakuga_card</item>
    </style>

    <!-- 更新弹窗的进出场动画 -->
    <style name="UpdateDialogAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="actionMenuTextColor">@color/primary_text</item>
        <item name="colorControlNormal">@color/primary_text</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- 加号按钮：15dp 圆角方块（Sakuga 按钮是圆角矩形，不是圆） -->
    <style name="SakugaFabShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

</resources>
