<?xml version="1.0" encoding="utf-8"?>
<!-- GlassSelect 菜单卡片：磨砂白纸面（半透明，透出背后的浅蓝渐变）+ 3dp 墨描边 + 向右 6dp、向下 7dp 的薰衣草平色阴影。
     玻璃是透的，底下得有东西给它折，所以这张卡片只用在主界面（渐变背景）弹出的菜单上。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="6dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/soft" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6FFFFFF" />
            <stroke
                android:width="3dp"
                android:color="@color/ink" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
