<?xml version="1.0" encoding="utf-8"?>
<!-- 启动页：冲击星旋转呼吸、标题逐字弹出、小星星漂浮、云朵起伏；2 秒后自动进主页 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 漂浮的小星星 -->
    <ImageView
        android:id="@+id/splash_star_1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:layout_marginTop="180dp"
        android:src="@drawable/ic_sakuga_burst" />

    <ImageView
        android:id="@+id/splash_star_2"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="320dp"
        android:src="@drawable/ic_sakuga_burst" />

    <ImageView
        android:id="@+id/splash_star_3"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="200dp"
        android:src="@drawable/ic_sakuga_burst" />

    <!-- 中间：冲击星 + 标题 + 标语 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splash_burst"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_sakuga_burst" />

        <LinearLayout
            android:id="@+id/splash_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="淑"
                android:textColor="@color/primary_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="婷"
                android:textColor="@color/primary_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分"
                android:textColor="@color/primary_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="身"
                android:textColor="@color/primary_text"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="一个应用，多个身份"
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 底部起伏的云 -->
    <top.niunaijun.blackboxa.view.sakuga.SakugaCloudView
        android:id="@+id/splash_cloud"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp" />

</FrameLayout>
